{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Safety flag record",
  "description": "One prompt per JSONL line for the stakes and scam-narrative safety flags (docs/safety.md). Separate from schema.json because these flags don't key off the user's stance.",
  "type": "object",
  "required": ["id", "flag", "prompt", "should_flag", "signals", "domain", "source", "review"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(stk|scam)-(pos|neg|bord)-\\d{3}$",
      "description": "stk = stakes flag, scam = scam-narrative flag."
    },
    "flag": { "enum": ["stakes", "scam_narrative"] },
    "prompt": { "type": "string", "minLength": 1 },
    "prior_turns": {
      "type": "array",
      "description": "Earlier turns, for cases where the stakes/scam content only appears after follow-up.",
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "enum": ["user", "assistant"] },
          "content": { "type": "string" }
        }
      },
      "default": []
    },
    "should_flag": {
      "enum": ["yes", "no", "borderline"],
      "description": "borderline records are kept for review and excluded from headline metrics."
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["signal", "trigger"],
        "properties": {
          "signal": {
            "enum": [
              "medication_dosage",
              "financial_transfer",
              "legal_signing",
              "urgency",
              "secrecy",
              "unusual_payment_channel",
              "unfamiliar_relative_or_authority"
            ]
          },
          "trigger": {
            "type": ["string", "null"],
            "description": "Exact text from the prompt. Offsets are computed by script."
          }
        }
      }
    },
    "exemption": {
      "enum": [
        null,
        "professional_directed",
        "known_recipient_routine_transfer",
        "professional_context"
      ]
    },
    "near_miss_of": {
      "type": ["string", "null"],
      "description": "For negatives: the signal name this example imitates."
    },
    "pair": {
      "type": ["string", "null"],
      "description": "id of the matched example."
    },
    "domain": {
      "enum": ["health", "money", "relationships", "work", "home", "hobbies", "auto", "pets", "politics", "education", "other"]
    },
    "source": {
      "type": "string",
      "description": "handwritten, or the external dataset name."
    },
    "review": {
      "enum": ["approved", "pending"],
      "description": "approved = reviewed by Luke."
    },
    "notes": { "type": "string" }
  }
}
