{
  "manifest_version": 3,
  "name": "How-To-Chat: Prompt Framing Checker",
  "version": "0.1.0",
  "description": "Flags prompts framed to get an agreeable answer instead of an honest one. Detection only, runs entirely on-device, never blocks sending.",
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": [
        "src/site-config.js",
        "src/detector.js",
        "src/safety-detector.js",
        "src/overlay.js",
        "src/input-watcher.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
